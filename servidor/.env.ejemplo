# Copiar a /opt/one/.env en el VPS (nunca a este repo) y rellenar los valores reales.
# Ver servidor/DESPLIEGUE.md para cómo se genera cada uno.
#
# PUERTO y RUTA_DATOS NO van aquí (Ronda final, I5): están fijos en
# servidor/docker-compose.yml (`environment:`), que gana a este fichero para esas dos claves --
# así nunca se pueden desajustar por accidente del puerto publicado ni del volumen de datos
# montado. Si algún día hiciera falta cambiarlos, se cambian en el docker-compose, no aquí.
OPENROUTER_API_KEY=
TOKEN_ONE=
PERMITIR_PAGO=
TOPE_EUR_DIA=

# Claves de los proveedores gratis de la cascada (v0.2b4.1). Todas SIN tarjeta y SIN facturación:
# un exceso de cuota devuelve 429 o 402, nunca un cargo. Cada una vale por sí sola -- si falta una,
# tools/openrouter.js se salta ese eslabón sin llamar y sigue con el siguiente.
# NO hace falta declararlas en servidor/docker-compose.yml: `env_file: ../.env` ya pasa al
# contenedor TODO lo que haya en /opt/one/.env. Declararlas además en `environment:` sería peor,
# no mejor: `environment:` gana a `env_file` y, sin valor en el shell que lanza el despliegue,
# borraría la clave real.
GEMINI_API_KEY_GRATIS=
GROQ_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
